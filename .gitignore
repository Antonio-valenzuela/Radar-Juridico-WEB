# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
__pycache__/
.venv/
/test-results/
/artifacts/
/screenshots/

# Next.js & Build
/.next/
/out/
/build
/dist

# OS & Temp
.DS_Store
*.tmp
*.temp
/tmp/
/temp/

# Keys & Certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
secrets/

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma & Generated Code
/app/generated/prisma
/.codegraph/

# Legal Workspace & User Data (Local ONLY - NEVER commit to Git)
data/legal-workspace/
data/uploads/
data/documents/
data/ocr/
data/exports/
data/thumbnails/
public/test-docs/

# Document files & User uploads
*.pdf
*.doc
*.docx
*.zip
*.mp4
*.mov
*.dump
*.sql

# Dev/personal images & generated reports
foto-tiktok*
sujeto-mask*
sujeto-recortado*
e2e-demo-report.json
test-curl.bat
