generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Item {
  id           String   @id @default(cuid())
  source       String
  sourceId     String?
  title        String
  url          String   @unique
  canonicalUrl String?  @unique
  hash         String?  @unique
  published    DateTime
  retrievedAt  DateTime @default(now())
  summary      String?
  rawRef       String?
  raw          Json?

  // Clasificación
  impacto     String? // "alto" | "medio" | "bajo"
  tipo        String? // "DECRETO" | "LEY" | "REGLAMENTO" | ...
  tema        String[] @default([]) // ["civil", "penal", "fiscal", ...]
  category    String? // "normativo" | "administrativo" | "ruido"
  keywordsHit String? // comma-separated keywords that triggered classification

  createdAt          DateTime            @default(now())
  normaVersions      NormaVersion[]
  documentVersions   DocumentVersion[]
  notificationLogs   NotificationLog[]
  consultantInsights ConsultantInsight[]
  aiEnrichment       ItemAiEnrichment?

  @@unique([source, sourceId])
  @@index([source, published])
  @@index([source, sourceId])
  @@index([category, published])
  @@index([impacto, published])
}

model Norma {
  id                 String                    @id @default(cuid())
  nombre             String
  sigla              String?
  fuente             String
  urlBase            String?
  aliases            Json?
  jurisdiction       String                    @default("MX")
  matter             String?
  officialSourceId   String?
  officialSource     OfficialSource?           @relation(fields: [officialSourceId], references: [id], onDelete: SetNull)
  publicationDate    DateTime?
  lastReformDate     DateTime?
  lastCheckedAt      DateTime?
  lastVerifiedAt     DateTime?
  currentHash        String?
  verificationStatus String                    @default("pending")
  monitoringStatus   String                    @default("pending")
  lastError          String?
  practicalUse       String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  versions           NormaVersion[]
  articles           NormaArticle[]
  reforms            NormaReform[]
  verifications      NormaSourceVerification[]

  @@unique([fuente, nombre])
  @@index([sigla])
  @@index([officialSourceId])
  @@index([jurisdiction, matter])
  @@index([verificationStatus, monitoringStatus])
  @@index([lastCheckedAt])
}

model NormaVersion {
  id           String         @id @default(cuid())
  normaId      String
  norma        Norma          @relation(fields: [normaId], references: [id], onDelete: Cascade)
  versionLabel String?
  publishedAt  DateTime?
  verifiedAt   DateTime       @default(now())
  hash         String
  textPath     String?
  text         String?
  sourceUrl    String?
  sourceItemId String?
  sourceItem   Item?          @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  articles     NormaArticle[]
  diffsFrom    NormaDiff[]    @relation("DiffFrom")
  diffsTo      NormaDiff[]    @relation("DiffTo")

  @@unique([normaId, hash])
  @@unique([sourceItemId])
  @@index([normaId, publishedAt])
  @@index([verifiedAt])
}

model NormaArticle {
  id            String       @id @default(cuid())
  normaId       String
  norma         Norma        @relation(fields: [normaId], references: [id], onDelete: Cascade)
  versionId     String
  version       NormaVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  articleNumber String
  heading       String?
  text          String       @db.Text
  sourceUrl     String?
  createdAt     DateTime     @default(now())

  @@unique([versionId, articleNumber])
  @@index([normaId, articleNumber])
}

model NormaReform {
  id              String   @id @default(cuid())
  normaId         String
  norma           Norma    @relation(fields: [normaId], references: [id], onDelete: Cascade)
  publicationDate DateTime
  officialUrl     String
  description     String?
  articlesChanged String[]
  createdAt       DateTime @default(now())

  @@unique([normaId, officialUrl])
  @@index([normaId, publicationDate])
}

model NormaSourceVerification {
  id          String   @id @default(cuid())
  normaId     String
  norma       Norma    @relation(fields: [normaId], references: [id], onDelete: Cascade)
  sourceUrl   String
  checkedAt   DateTime @default(now())
  status      String
  httpStatus  Int?
  contentHash String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([normaId, checkedAt])
  @@index([status, checkedAt])
}

model NormaDiff {
  id                 String              @id @default(cuid())
  fromVersionId      String?
  fromVersion        NormaVersion?       @relation("DiffFrom", fields: [fromVersionId], references: [id], onDelete: SetNull)
  toVersionId        String
  toVersion          NormaVersion        @relation("DiffTo", fields: [toVersionId], references: [id], onDelete: Cascade)
  changedArticles    Json
  summaryBullets     Json
  executiveSummary   String?
  practicalImpact    String?
  recommendedAction  String?
  createdAt          DateTime            @default(now())
  consultantInsights ConsultantInsight[]

  @@unique([toVersionId])
  @@index([fromVersionId])
}

model ConsultantInsight {
  id                String     @id @default(cuid())
  itemId            String
  item              Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  diffId            String?
  diff              NormaDiff? @relation(fields: [diffId], references: [id], onDelete: SetNull)
  provider          String
  model             String
  promptVersion     String
  inputHash         String
  executiveSummary  String
  keyChanges        Json
  affectedParties   Json
  actionItems       Json
  riskFlags         Json
  followUpQuestions Json
  confidence        String
  generatedAt       DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([itemId, inputHash, promptVersion])
  @@index([itemId, generatedAt])
  @@index([diffId])
}

model Alert {
  id        String   @id @default(cuid())
  email     String
  keyword   String
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  onlyHighImpact   Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  watchlists       Watchlist[]
  notifications    NotificationLog[]
  alertRules       AlertRule[]
  appNotifications Notification[]
  auditLogs        AuditLog[]
  orgRoles         OrgUserRole[]
  userAlerts       UserAlert[]
  assignedMatters  Matter[]          @relation("MatterAssignee")
}

model Organization {
  id                     String            @id @default(cuid())
  name                   String
  slug                   String            @unique
  dailyNotificationLimit Int               @default(50)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  roles                  OrgUserRole[]
  watchlists             Watchlist[]
  notifications          NotificationLog[]
  alertRules             AlertRule[]
  appNotifications       Notification[]
  auditLogs              AuditLog[]
  clients                Client[]
  matters                Matter[]
}

model OrgUserRole {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

model Watchlist {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type      String
  value     String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([orgId, userId, type, value])
  @@index([type, value])
  @@index([orgId])
}

model NotificationLog {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  itemId  String
  item    Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channel String
  sentAt  DateTime     @default(now())
  status  String
  error   String?

  @@unique([orgId, userId, itemId, channel])
  @@index([sentAt])
  @@index([orgId, sentAt])
}

model IngestRun {
  id          String    @id @default(cuid())
  source      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  ok          Boolean   @default(false)
  itemsFound  Int       @default(0)
  itemsSaved  Int       @default(0)
  duplicates  Int       @default(0)
  errorsCount Int       @default(0)
  error       String?
}

model IngestCheckpoint {
  id              String    @id @default(cuid())
  source          String    @unique
  cursor          String?
  lastPublishedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

model MetricsDaily {
  id           String   @id @default(cuid())
  date         DateTime @unique
  sourceCounts Json
  impactCounts Json
  topicCounts  Json
  typeCounts   Json
  topNormas    Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
}

model Document {
  id                String    @id @default(cuid())
  source            String
  jurisdiction      String    @default("MX")
  documentType      String
  title             String
  canonicalKey      String    @unique
  canonicalUrl      String?   @unique
  status            String    @default("active")
  summary           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  hasVersions       Boolean   @default(false)
  latestVersionHash String? // Hash SHA256 para detectar duplicados
  shortCode         String?
  matter            String?
  officialSourceId  String?
  officialUrl       String?
  officialSourceUrl String?
  currentHash       String?
  etag              String?
  lastModified      DateTime?
  fileSize          BigInt?
  lastCheckedAt     DateTime?
  lastError         String?
  monitoringStatus  String?
  changeSummary     String?

  versions       DocumentVersion[]
  metadata       DocumentMetadata[]
  ingestionJobs  IngestionJob[]
  officialSource OfficialSource?    @relation(fields: [officialSourceId], references: [id], onDelete: SetNull)

  @@index([source, documentType])
  @@index([status, updatedAt])
  @@index([matter, monitoringStatus])
  @@index([officialSourceId])
  @@index([lastCheckedAt])
  @@index([shortCode])
}

model DocumentVersion {
  id            String    @id @default(cuid())
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionLabel  String?
  publishedAt   DateTime?
  effectiveFrom DateTime?
  contentHash   String
  rawRef        String?
  rawText       String?
  diffSummary   Json?
  etag          String?
  lastModified  DateTime?
  fileSize      BigInt?
  sourceUrl     String?
  metadata      Json?
  sourceItemId  String?
  sourceItem    Item?     @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Campos adicionales requeridos por la Tarea 1:
  versionNumber Int              @default(1)
  originalText  String?          @db.Text
  changes       DocumentChange[]

  chunks        DocumentChunk[]
  notifications Notification[]

  @@unique([documentId, contentHash])
  @@unique([documentId, versionNumber])
  @@index([publishedAt])
  @@index([sourceItemId])
  @@index([documentId, createdAt])
}

model DocumentMetadata {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  key             String
  value           String
  normalizedValue String?
  confidence      Float?
  createdAt       DateTime @default(now())

  @@index([key, normalizedValue])
  @@index([documentId, key])
}

model DocumentChunk {
  id                String          @id @default(cuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  chunkIndex        Int
  sectionPath       String?
  article           String?
  text              String
  tokenCount        Int
  citationAnchor    String?
  createdAt         DateTime        @default(now())

  embeddings Embedding[]

  @@unique([documentVersionId, chunkIndex])
  @@index([documentVersionId])
  @@index([article])
}

model Embedding {
  id        String                       @id @default(cuid())
  chunkId   String
  chunk     DocumentChunk                @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  model     String
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())

  @@unique([chunkId, model])
  @@index([model])
}

model AlertRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  ruleType       String
  query          String?
  filters        Json?
  frequency      String       @default("daily")
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  notifications Notification[]

  @@index([organizationId, enabled])
  @@index([userId])
}

model Notification {
  id                String           @id @default(cuid())
  alertRuleId       String?
  alertRule         AlertRule?       @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentVersionId String?
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  channel           String
  status            String
  dedupeKey         String?          @unique
  payload           Json?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([organizationId, createdAt])
  @@index([alertRuleId])
  @@index([status, channel])
}

model ProcessingJob {
  id             String    @id @default(cuid())
  queueName      String
  jobName        String
  jobId          String?
  type           String
  source         String?
  status         String
  attempt        Int       @default(0)
  payload        Json?
  result         Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  progress       Int       @default(0)
  stage          String    @default("queued")
  userId         String?
  organizationId String?
  input          Json?

  failed DeadLetterJob?

  @@unique([queueName, jobId])
  @@index([queueName, status])
  @@index([type, createdAt])
}

model DeadLetterJob {
  id              String         @id @default(cuid())
  processingJobId String?        @unique
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  queueName       String
  jobName         String
  payload         Json?
  error           String
  failedAt        DateTime       @default(now())
  replayedAt      DateTime?
  replayedBy      String?

  @@index([queueName, failedAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  dedupeKey      String?       @unique
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model WeeklyDigest {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  content   String
  createdAt DateTime @default(now())

  @@unique([startDate, endDate])
}

model ItemAiEnrichment {
  id               String   @id @default(cuid())
  itemId           String   @unique
  matter           String
  authority        String?
  entities         Json
  affectedSectors  Json
  keywords         Json
  relatedTopics    Json
  impactLevel      String
  executiveSummary String?
  explanation      String?
  provider         String
  confidence       Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AiUsageLog {
  id               String   @id @default(cuid())
  provider         String
  model            String?
  operation        String
  status           String
  reasonCategory   String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  costSource       String? // provider_metadata | provider_account_endpoint | estimated | unavailable
  durationMs       Int
  fallbackUsed     Boolean  @default(false)
  requestId        String?
  createdAt        DateTime @default(now())

  // Rate limits normalizados
  rateLimitLimit     Int?
  rateLimitRemaining Int?
  rateLimitResetAt   String?
  rateLimitSource    String?

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([operation, createdAt])
  @@index([requestId])
}

model OfficialSource {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  baseUrl           String
  adapter           String    @default("GENERIC_HTML")
  healthUrl         String?
  requiresBrowser   Boolean   @default(false)
  type              String // dof | sidof | scjn | sjf | diputados | court | congress | government | gazette | custom_official
  jurisdiction      String    @default("MX")
  country           String    @default("MX")
  state             String?
  matter            String?
  description       String?
  isActive          Boolean   @default(true)
  isOfficial        Boolean   @default(true)
  trustLevel        String    @default("official") // official | verified | manual_review | untrusted
  crawlMode         String    @default("api") // rss | sitemap | html | api | manual_url | search_only
  refreshFrequency  String    @default("daily")
  lastCheckedAt     DateTime?
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastErrorCategory String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  fetchLogs       OfficialSourceFetchLog[]
  documents       Document[]
  normas          Norma[]
  jurisprudencias Jurisprudencia[]
  bulletinWatches       CaseBulletinWatch[]
  bulletinEntries       JudicialBulletinEntry[]
  bulletinRuns          BulletinCheckRun[]
  bulletinSubscriptions BulletinSubscription[]

  @@index([type])
  @@index([isActive])
  @@index([trustLevel])
}

model OfficialSourceFetchLog {
  id             String         @id @default(cuid())
  sourceId       String
  source         OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status         String // success | failed
  foundItems     Int            @default(0)
  savedItems     Int            @default(0)
  duplicateItems Int            @default(0)
  errorCategory  String?
  durationMs     Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([sourceId, createdAt])
  @@index([createdAt])
}

model IngestionJob {
  id          String    @id @default(cuid())
  source      String // "DOF", "SCJN", "SJF", etc.
  documentUrl String
  status      String // PENDIENTE, DESCARGANDO, EXTRAYENDO_TEXTO, GENERANDO_EMBEDDINGS, CLASIFICANDO_CON_IA, COMPLETADO, FALLIDO, REINTENTANDO, EN_DEAD_LETTER_QUEUE
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  lastRetryAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relaciones
  documentId String?
  document   Document?      @relation(fields: [documentId], references: [id])
  logs       IngestionLog[]
}

model IngestionLog {
  id             String       @id @default(cuid())
  ingestionJobId String
  ingestionJob   IngestionJob @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)
  message        String       @db.Text // "Iniciando descarga", "Error: timeout 30s", etc.
  level          String // "INFO", "WARN", "ERROR"
  timestamp      DateTime     @default(now())
}

model DocumentChange {
  id                String          @id @default(cuid())
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  changeType        String // "modified", "added", "removed"
  before            String?  @db.Text // Texto anterior
  after             String?  @db.Text // Texto nuevo
  changeDescription String   @db.Text // Descripción legible
  sourceUrl         String?
  detectedAt        DateTime @default(now())
  previousHash      String?
  newHash           String?
  priority          String   @default("media")
  reviewStatus      String   @default("nueva")
  matter            String?
  jurisdiction      String?

  // Extracción de cambios específicos
  extractedPlazoDias  Int? // Si es cambio de plazo
  extractedPorcentaje Float?
  extractedMontoMX    Float?

  createdAt DateTime @default(now())
}

model UserAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  keywords String[] // ["ISR", "vacaciones", "reforma laboral"]
  filters  Json? // { fuente: ["DOF"], materia: ["Fiscal"] }
  isActive Boolean  @default(true)

  notifications AlertNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlertNotification {
  id      String    @id @default(cuid())
  alertId String
  alert   UserAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  documentId String?
  title      String
  summary    String  @db.Text
  relevance  Float // 0 a 1

  read      Boolean   @default(false)
  emailSent Boolean   @default(false)
  sentAt    DateTime?

  createdAt DateTime @default(now())
}

// ─── Clientes, Asuntos y Expedientes (Fase 6) ──────────────────────────────────

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  rfc            String?
  email          String?
  phone          String?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  matters Matter[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

model Matter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedUserId String?
  assignedUser   User?        @relation("MatterAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  title          String
  description    String?
  status         String       @default("open") // open | closed | archived
  matter         String? // fiscal | laboral | civil | etc.
  reference      String? // internal reference number
  jurisdiction   String?
  court          String?
  caseNumber     String?
  lastReviewedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  caseFiles             CaseFile[]
  documents             MatterDocument[]
  notes                 MatterNote[]
  parties               CaseParty[]
  actuations            CaseActuation[]
  deadlines             CaseDeadline[]
  sourceChecks          CaseSourceCheck[]
  caseAlerts            CaseAlert[]
  bulletinWatches       CaseBulletinWatch[]
  bulletinEntries       JudicialBulletinEntry[]
  bulletinRuns          BulletinCheckRun[]
  matterBulletinEntries MatterBulletinEntry[]

  @@index([organizationId, status])
  @@index([organizationId, caseNumber])
  @@index([clientId])
  @@index([assignedUserId])
}

model CaseFile {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title     String
  fileType  String   @default("general") // court_filing | evidence | contract | correspondence | general
  url       String?
  content   String?  @db.Text
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matterId])
}

model MatterDocument {
  id       String   @id @default(cuid())
  matterId String
  matter   Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  itemId   String?
  title    String
  url      String?
  summary  String?
  addedAt  DateTime @default(now())

  @@unique([matterId, itemId])
  @@index([matterId])
}

model MatterNote {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId    String?
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([matterId])
}

model AiUsageEvent {
  id            String   @id @default(cuid())
  requestId     String
  provider      String
  model         String?
  strategy      String?
  fallbackRank  Int?
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  estimatedCost Decimal? @db.Decimal(12, 6)
  latencyMs     Int
  success       Boolean
  errorCode     String?
  route         String?
  mode          String?
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
  @@index([requestId])
  @@index([mode, createdAt])
  @@index([createdAt])
}

model AiProviderHealth {
  id                  String    @id @default(cuid())
  provider            String    @unique
  consecutiveFailures Int       @default(0)
  lastFailureAt       DateTime?
  lastSuccessAt       DateTime?
  lastErrorCode       String?
  disabledUntil       DateTime?
  updatedAt           DateTime  @updatedAt
}

model Jurisprudencia {
  id                 String          @id @default(cuid())
  registroDigital    String?         @unique
  rubro              String
  text               String          @db.Text
  type               String
  matter             String
  epoch              String?
  instance           String?
  issuingBody        String?
  publicationDate    DateTime?
  sourceUrl          String?
  officialUrl        String?
  officialSourceId   String?
  officialSource     OfficialSource? @relation(fields: [officialSourceId], references: [id], onDelete: SetNull)
  verificationStatus String          @default("pending")
  lastVerifiedAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  precedents     JurisprudenciaPrecedent[]
  contradictions JurisprudenciaContradiction[]

  @@index([matter, type])
  @@index([epoch])
  @@index([instance])
  @@index([issuingBody])
  @@index([verificationStatus, publicationDate])
  @@index([officialSourceId])
}

model JurisprudenciaPrecedent {
  id               String         @id @default(cuid())
  jurisprudenciaId String
  jurisprudencia   Jurisprudencia @relation(fields: [jurisprudenciaId], references: [id], onDelete: Cascade)
  relatedRegistro  String?
  description      String?
  createdAt        DateTime       @default(now())
}

model JurisprudenciaContradiction {
  id               String         @id @default(cuid())
  jurisprudenciaId String
  jurisprudencia   Jurisprudencia @relation(fields: [jurisprudenciaId], references: [id], onDelete: Cascade)
  contradictionId  String?
  description      String?
  createdAt        DateTime       @default(now())
}

model CaseParty {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  role      String
  name      String
  rfc       String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([matterId])
}

model CaseActuation {
  id                    String                 @id @default(cuid())
  matterId              String
  matter                Matter                 @relation(fields: [matterId], references: [id], onDelete: Cascade)
  date                  DateTime
  type                  String
  summary               String
  sourceUrl             String?
  bulletinEntryId       String?                @unique
  bulletinEntry         JudicialBulletinEntry? @relation(fields: [bulletinEntryId], references: [id], onDelete: SetNull)
  matterBulletinEntryId String?                @unique
  matterBulletinEntry   MatterBulletinEntry?   @relation(fields: [matterBulletinEntryId], references: [id], onDelete: SetNull)
  reviewed              Boolean                @default(false)
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())

  @@index([matterId, date])
}

model CaseDeadline {
  id              String    @id @default(cuid())
  matterId        String
  matter          Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title           String
  dueDate         DateTime
  dueTime         String?
  timezone        String    @default("America/Mexico_City")
  dayType         String    @default("calendar_date") // calendar_date | business_day | judicial_calendar
  calendarStatus  String    @default("unverified") // unverified | verified
  calculationNote String?
  type            String
  daysTotal       Int?
  completed       Boolean   @default(false)
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([matterId, dueDate])
  @@index([completed, dueDate])
}

model CaseSourceCheck {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  sourceId  String
  checkedAt DateTime
  result    String
  details   String?
  createdAt DateTime @default(now())

  @@index([matterId, checkedAt])
}

model CaseAlert {
  id          String   @id @default(cuid())
  matterId    String
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  level       String
  title       String
  description String?
  read        Boolean  @default(false)
  dedupeKey   String?  @unique
  createdAt   DateTime @default(now())

  @@index([matterId, read])
  @@index([level, createdAt])
}

model CaseBulletinWatch {
  id                    String         @id @default(cuid())
  matterId              String
  matter                Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  sourceId              String
  source                OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  expedienteNumber      String
  expedienteYear        Int?
  matterLabel           String?
  judicialDistrict      String?
  court                 String?
  chamber               String?
  subjectExternalId     String?
  districtExternalId    String?
  courtExternalId       String?
  active                Boolean        @default(true)
  lastCheckedAt         DateTime?
  lastSuccessfulAt      DateTime?
  lastPublishedAt       DateTime?
  nextCheckAt           DateTime?
  lastQueryStatus       String?
  lastPublicationStatus String?
  lastErrorCode         String?
  lastErrorMessage      String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  checkRuns BulletinCheckRun[]

  @@unique([matterId, sourceId, expedienteNumber])
  @@index([sourceId, active])
  @@index([active, lastCheckedAt])
  @@index([matterId, active])
}

model JudicialBulletinEntry {
  id                 String         @id @default(cuid())
  sourceId           String
  source             OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  matterId           String?
  matter             Matter?        @relation(fields: [matterId], references: [id], onDelete: SetNull)
  externalId         String?
  expedienteNumber   String
  expedienteYear     Int?
  matterLabel        String?
  judicialDistrict   String?
  court              String?
  chamber            String?
  bulletinNumber     String?
  publicationDate    DateTime?
  agreementDate      DateTime?
  proceedingType     String?
  heading            String?
  extract            String?        @db.Text
  parties            Json?
  sourceUrl          String
  contentHash        String
  dedupeKey          String         @unique
  evidenceKind       String         @default("legacy_unclassified")
  origin             String         @default("OFFICIAL_PUBLIC_SOURCE")
  adapterVersion     String?
  publicationDateRaw String?
  agreementDateRaw   String?
  evidence           Json?
  firstSeenAt        DateTime       @default(now())
  lastSeenAt         DateTime       @default(now())
  raw                Json?
  verificationStatus String         @default("official_source")
  reviewed           Boolean        @default(false)
  reviewedAt         DateTime?
  notes              String?

  actuation   CaseActuation?
  matterLinks MatterBulletinEntry[]

  @@index([sourceId, expedienteNumber])
  @@index([matterId, publicationDate])
  @@index([court, expedienteNumber, publicationDate])
  @@index([contentHash])
}

model MatterBulletinEntry {
  id              String                @id @default(cuid())
  matterId        String
  matter          Matter                @relation(fields: [matterId], references: [id], onDelete: Cascade)
  bulletinEntryId String
  bulletinEntry   JudicialBulletinEntry @relation(fields: [bulletinEntryId], references: [id], onDelete: Cascade)
  firstSeenAt     DateTime              @default(now())
  lastSeenAt      DateTime              @default(now())
  reviewed        Boolean               @default(false)
  reviewedAt      DateTime?
  notes           String?
  actuation       CaseActuation?

  @@unique([matterId, bulletinEntryId])
  @@index([matterId, lastSeenAt])
  @@index([bulletinEntryId])
}

model BulletinCheckRun {
  id                String             @id @default(cuid())
  sourceId          String
  source            OfficialSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  matterId          String?
  matter            Matter?            @relation(fields: [matterId], references: [id], onDelete: SetNull)
  watchId           String?
  watch             CaseBulletinWatch? @relation(fields: [watchId], references: [id], onDelete: SetNull)
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  status            String
  queryStatus       String?
  publicationStatus String?
  query             Json
  resultsFound      Int                @default(0)
  newResults        Int                @default(0)
  errorCode         String?
  errorMessage      String?
  responseHash      String?
  sourceUrl         String?
  httpStatus        Int?
  durationMs        Int?
  contentType       String?
  adapterVersion    String?
  origin            String?
  evidence          Json?

  @@index([sourceId, startedAt])
  @@index([matterId, startedAt])
  @@index([status, startedAt])
  @@index([watchId, startedAt])
}

model BulletinSubscription {
  id               String         @id @default(cuid())
  organizationId   String
  userId           String?
  sourceId         String
  source           OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  expediente       String?
  actor            String?
  demandado        String?
  juzgado          String?
  abogado          String?
  keywords         Json?
  frequency        String         @default("diario")
  status           String         @default("active")
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  lastQueryStatus  String?
  lastErrorMessage String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  matches BulletinMatch[]

  @@index([organizationId, status])
  @@index([sourceId, status])
  @@index([status, nextRunAt])
  @@index([userId])
}

model BulletinMatch {
  id                 String               @id @default(cuid())
  subscriptionId     String
  subscription       BulletinSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  publicationId     String?
  publicationTitle  String?
  publicationExtract String?              @db.Text
  publicationUrl    String?
  publicationDate   DateTime?
  court              String?
  expediente         String?
  matchReason        String
  matchedFields      Json?
  score              Float                @default(1.0)
  seenAt             DateTime             @default(now())
  notifiedAt         DateTime?
  reviewed           Boolean              @default(false)
  reviewedAt         DateTime?

  @@index([subscriptionId, seenAt])
  @@index([subscriptionId, reviewed])
  @@index([notifiedAt])
}

model LegalDraft {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  templateId     String?
  template       LegalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title          String
  documentType   String   @default("machote")
  matter         String?
  jurisdiction   String?  @default("federal")
  formData       Json?
  renderedText   String?  @db.Text
  pendingMarkers Json?
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([userId, status])
  @@index([organizationId, updatedAt])
}

enum TemplateVisibility {
  PRIVATE
  ORG
  PUBLIC
}

model LegalTemplate {
  id             String             @id @default(cuid())
  slug           String?
  title          String
  category       String             @default("General")
  jurisdiction   String             @default("federal")
  practiceArea   String?
  documentType   String             @default("machote")
  description    String?
  content        String?            @db.Text
  originalText   String?            @db.Text
  legalBasis     String?
  variables      Json?
  structureJson  Json?
  applicableLaws Json?
  warnings       Json?
  disclaimer     String?
  exportFormats  Json?
  aiInstructions String?            @db.Text
  systemPrompt   String?            @db.Text
  contentHash    String?
  version        Int                @default(1)
  visibility     TemplateVisibility @default(ORG)
  organizationId String
  createdBy      String?
  sourceFileName String?
  indexed        Boolean            @default(false)
  indexedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  drafts         LegalDraft[]

  @@unique([organizationId, slug])
  @@index([organizationId, updatedAt])
  @@index([createdBy])
  @@index([category])
  @@index([contentHash])
}
